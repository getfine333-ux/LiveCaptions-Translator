<Page x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage" JournalEntry.KeepAlive="True">
    <Grid x:Name="CaptionLayout" Margin="14,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="CaptionLogCard_Row" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <CollectionViewSource x:Key="RecentHistory" Source="{Binding DisplayLogCards}">
                <CollectionViewSource.SortDescriptions>
                    <scm:SortDescription PropertyName="Id" Direction="Descending" />
                </CollectionViewSource.SortDescriptions>
            </CollectionViewSource>
            <DataTemplate x:Key="BilingualCaption">
                <Border Padding="14,12" Margin="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="#20888888">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="原文" Opacity="0.55" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" TextWrapping="Wrap"
                            FontSize="16" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                            Cursor="Hand" ToolTip="点击复制" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                        <TextBlock Grid.Row="1" Text="译文" Opacity="0.55" FontSize="12" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TranslatedText}" TextWrapping="Wrap"
                            FontSize="19" FontWeight="SemiBold" LineHeight="29" Margin="0,8,0,0"
                            LineStackingStrategy="BlockLineHeight" Cursor="Hand" ToolTip="点击复制"
                            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid Grid.Row="0" Margin="14,0,14,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding ReadingTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ui:Button x:Name="HomeGlossaryButton" AutomationProperties.AutomationId="HomeGlossary"
                    Content="术语生成 / 编辑" Padding="10,4" Click="Glossary_Click"
                    ToolTip="描述领域生成术语，编辑并保存后用于后续翻译。" />
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox Content="从容阅读" IsChecked="{Binding ComfortReading}" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="开启后逐段按全文长度停留，可能落后于视频。关闭时跟随语音节奏，连续短句可合为一页完整展示，每页至少停留 4 秒。" />
                <ui:Button Content="{Binding ReadingPauseLabel}" Click="PauseReading_Click" Padding="10,4" Margin="0,0,6,0"
                    ToolTip="只停留字幕，识别和翻译继续进行" />
                <ui:Button Content="下一段" Click="NextReading_Click" IsEnabled="{Binding CanReadNext}" Padding="10,4" Margin="0,0,6,0" />
                <ui:Button Content="跳到最新" Click="LatestReading_Click" IsEnabled="{Binding CanJumpToLatest}" Padding="10,4"
                    ToolTip="跳过待阅读内容；完整内容仍可在历史记录中查看" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReadingStatus}" ToolTip="{Binding ReadingStatus}"
                TextTrimming="CharacterEllipsis" Height="18" FontSize="12" Opacity="0.6" Margin="0,7,0,0" />
        </Grid>
        <ScrollViewer x:Name="ReadingScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
            PreviewMouseWheel="Reading_PreviewMouseWheel" PreviewKeyDown="Reading_PreviewKeyDown" ScrollChanged="Reading_ScrollChanged">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding DisplayReadingCards}" ItemTemplate="{StaticResource BilingualCaption}" />
                <ContentControl Content="{Binding PreviousReadingPage}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviousReadingPage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Border Padding="14,8" Margin="0,8,0,0" BorderBrush="#20888888" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="上一页 · 可继续阅读" FontSize="11" Opacity="0.55" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SourceText}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" Cursor="Hand" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                                    <TextBlock Text="{Binding TranslatedText}" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,0" Cursor="Hand" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Opacity="0.65" FontSize="12"
            TextWrapping="Wrap" Margin="14,4,14,6" />
        <Grid x:Name="LogCards" Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="更早的字幕 · 最近的在上方" FontSize="12" Opacity="0.55" Margin="14,0,0,4" />
            <ListBox x:Name="LogCardItems" Grid.Row="1" ItemsSource="{Binding Source={StaticResource RecentHistory}}"
                BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                PreviewMouseWheel="Reading_PreviewMouseWheel" PreviewKeyDown="Reading_PreviewKeyDown"
                ScrollViewer.ScrollChanged="Reading_ScrollChanged"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="#20888888">
                            <StackPanel>
                                <TextBlock FontSize="11" Opacity="0.5" Margin="0,0,0,4"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Timestamp, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" FontSize="13" Opacity="0.7"
                                    Cursor="Hand" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                                <TextBlock Text="{Binding TranslatedText}" TextWrapping="Wrap" FontSize="15" Margin="0,5,0,0"
                                    Cursor="Hand" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
